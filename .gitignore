/.local/
/target/
**/__pycache__/
*.py[cod]
/.venv/
# Downloaded/decompiled game content and private profiling artifacts.
*.jar
*.class
*.jfr
*.hprof
/decompiled/
/minecraft/
/assets/
/run/
/logs/
/dist/
/mods/horizon/build/
# Local `mods/` of a game folder: wasm and content test mods, plus the wasm
# host's fixture. The Java parity oracle in `mods/horizon/` is tracked, so it
# stays visible; everything else under `mods/` is local.
/mods/*
!/mods/horizon/
/saves/
/backups/
/tools/logs/
.DS_Store
# What the client writes to its working directory when run from the repo root.
/options.txt
/debug-profile.json
/horizon.txt
/horizon-graphics.txt
/horizon-controller.txt
/horizon-extras.txt
/horizon-player.txt
/servers.dat
/screenshots/
/.horizon-cache/
/crash-reports/
/debug/

# Release-only compiled original exporter bundle.
/exporters/
